# Copy this file to .env and fill in your key.
#   cp .env.example .env

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: which model drives the agent (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: cluster mode.
#   mock  -> uses the built-in simulated cluster (no real k8s needed) [default]
#   real  -> shells out to your real `kubectl` (needs a working kubeconfig)
CLUSTER_MODE=mock

# Optional: namespace + deployment used in REAL mode
K8S_NAMESPACE=default
K8S_DEPLOYMENT=web-api

# Optional: safety cap on how many reasoning/tool steps the agent may take
MAX_STEPS=12
